# Household, self-hosted: every setting. Copy to .env next to docker-compose.yml and
# change what you need; empty lines keep the default. Restart after changes:
#   docker compose up -d

# --- Address and HTTPS -------------------------------------------------------------------------

# Your domain (e.g. home.example.com). The home opens on it and each app on its own name:
# expenses.<domain>, utilities.<domain>, shopping.<domain>, cookbook.<domain>, meals.<domain>.
# Point the domain and those names (or a wildcard *.<domain>) at the server; Caddy gets HTTPS
# certificates by itself.
DOMAIN=

# No domain? The server's IP address (e.g. 203.0.113.5): the apps then use free sslip.io names
# (203-0-113-5.sslip.io, expenses.203-0-113-5.sslip.io, ...) with HTTPS, without setting up DNS.
# Ignored when DOMAIN is set.
PUBLIC_IP=

# The address people open, for links in emails. Empty: https://DOMAIN, or the address of each
# request.
PUBLIC_URL=

# Port for HTTP on the server.
HTTP_PORT=80

# Port for HTTPS on the server.
HTTPS_PORT=443

# --- Database (the MySQL container in this file) -----------------------------------------------

# The instance's database; each app gets its own next to it (household_expenses, ...).
DB_NAME=household

# MySQL's root password: the app creates one database per app, which needs root. The database is
# not reachable from outside the server, but change it before the first start if you can: it
# cannot be changed here afterwards.
DB_ROOT_PASSWORD=household-change-me

# --- Email (optional: reminders and notices) ---------------------------------------------------

# Your SMTP server, e.g. smtp.hostinger.com. Empty: no emails.
SMTP_HOST=

# 587 (STARTTLS) or 465 (TLS).
SMTP_PORT=587

# true for port 465. Empty: decided by the port.
SMTP_SECURE=

# SMTP user name.
SMTP_USER=

# SMTP password.
SMTP_PASSWORD=

# Sender, e.g. "Pulse <no-reply@example.com>". Empty: SMTP_USER.
SMTP_FROM=

# --- Instance ----------------------------------------------------------------------------------

# Language of emails: en, de, ro or hu.
DEFAULT_LOCALE=en

# false hides the "powered by DevQuake" line at the bottom of every page.
SHOW_POWERED_BY=true

# Instance secret. Made on first start and kept in the data volume; set it to manage it yourself.
APP_SECRET=

# Image tag to run, e.g. a version number.
APP_VERSION=latest
