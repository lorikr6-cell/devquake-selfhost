# Store, self-hosted: every setting. Copy to .env next to docker-compose.yml and
# change what you need; empty lines keep the default. Restart after changes:
#   docker compose up -d

# --- Address and HTTPS -------------------------------------------------------------------------

# Your domain for this app (e.g. store.example.com), pointed at the server. Caddy then gets an
# HTTPS certificate by itself. Empty: plain HTTP on the server's IP address.
DOMAIN=

# The address people open, for links in emails. Empty: https://DOMAIN, or the address of each
# request.
PUBLIC_URL=

# Port for HTTP on the server.
HTTP_PORT=80

# Port for HTTPS on the server.
HTTPS_PORT=443

# --- Database (the MySQL container in this file) -----------------------------------------------

# Database name.
DB_NAME=store

# Database user.
DB_USER=store

# Database password. The database is not reachable from outside the server, but change it before
# the first start if you can: it cannot be changed here afterwards.
DB_PASSWORD=store-change-me

# --- Email (optional: reminders and notices) ---------------------------------------------------

# Your SMTP server, e.g. smtp.hostinger.com. Empty: no emails.
SMTP_HOST=

# 587 (STARTTLS) or 465 (TLS).
SMTP_PORT=587

# true for port 465. Empty: decided by the port.
SMTP_SECURE=

# SMTP user name.
SMTP_USER=

# SMTP password.
SMTP_PASSWORD=

# Sender, e.g. "Pulse <no-reply@example.com>". Empty: SMTP_USER.
SMTP_FROM=

# --- Instance ----------------------------------------------------------------------------------

# Language of emails: en, de, ro or hu.
DEFAULT_LOCALE=en

# false hides the "powered by DevQuake" line at the bottom of every page.
SHOW_POWERED_BY=true

# Instance secret. Made on first start and kept in the data volume; set it to manage it yourself.
APP_SECRET=

# Image tag to run, e.g. a version number.
APP_VERSION=latest

# --- Store -------------------------------------------------------------------------------------

# Encrypts the Stripe and PayPal secrets the shop owner enters (32 random bytes, base64). Made on
# first start and kept in the data volume; set it to manage it yourself. Changing it makes the
# saved secrets unreadable: enter them again.
STORE_MASTER_KEY=
